# Open-Sora v2 API - Environment Configuration

# This file configures LOCAL SCRIPTS (build.ps1, deploy.ps1, etc.)
# Container runtime config comes from Vertex AI deployment or docker run -e
#
# Copy this file to .env and fill in your values
# Usage: Scripts read .env automatically via myconfig.ps1


# LOCAL SCRIPT CONFIGURATION (used by build.ps1, deploy.ps1, etc.)


# GCP Project Configuration
export PROJECT_ID="YOUR_PROJECT_ID"
export REGION="europe-west4"  # A2/A3 machines available in europe-west4
export REPOSITORY="opensora-serving-api"
export IMAGE_NAME="opensora-api"
export TAG="v1.0.0"

# Derived: Full image URI for Artifact Registry
export IMAGE_URI="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${IMAGE_NAME}:${TAG}"

# Vertex AI Deployment
export MODEL_NAME="opensora-video-${TAG}"
export ENDPOINT_NAME="opensora-video-endpoint"
export MACHINE_TYPE="a2-ultragpu-1g"
export ACCELERATOR_TYPE="nvidia-a100-80gb"
export SERVICE_ACCOUNT="ml-model-serving@${PROJECT_ID}.iam.gserviceaccount.com"


# CONTAINER RUNTIME CONFIGURATION (passed to deployed container)

# These are embedded in Dockerfile as defaults but should be overridden
# at deployment time via Vertex AI environment variables or docker run -e

# Model Weights Configuration
# GCS bucket containing Open-Sora v2 model weights (REQUIRED)
export WEIGHT_BUCKET="YOUR_WEIGHTS_BUCKET"

# Path prefix in bucket where weights are stored
export WEIGHT_PREFIX="ckpts/"

# Local path where weights will be downloaded inside container
export MODEL_PATH="/app/ckpts"

# Set to "true" to re-download weights even if they exist
export FORCE_DOWNLOAD="false"

# API Server Configuration
# Port for the FastAPI server (Vertex AI expects 8080)
export PORT="8080"

# Job Manager Configuration
# How long to keep completed/failed jobs before cleanup (seconds)
export JOB_RETENTION_SECONDS="3600"

# Maximum number of completed jobs to keep in memory
export MAX_COMPLETED_JOBS="100"

# Video Generation Defaults (API Request Level)
# Default resolution when not specified in request
# Options: "256px" (fast), "768px" (high quality)
export DEFAULT_RESOLUTION="256px"

# Default number of frames (4k+1 format)
# Options: 17, 33, 49, 65, 81, 97, 113, 129
export DEFAULT_NUM_FRAMES="49"

# Default aspect ratio
# Options: "16:9", "9:16", "1:1", "2.39:1"
export DEFAULT_ASPECT_RATIO="16:9"

# Default generation mode
# Options: "t2v_single_gpu" (optimized single GPU), "t2v" (direct text→video), "t2i2v" (text→image→video)
export DEFAULT_MODE="t2v_single_gpu"

# Default frames per second
export DEFAULT_FPS="24"

# Default number of video samples to generate per request
export DEFAULT_NUM_SAMPLES="1"

# Generation Parameters (Runner Level)
# Default motion intensity (1-5 or "dynamic")
export DEFAULT_MOTION_SCORE="4"

# Default diffusion steps (more = higher quality, slower)
export DEFAULT_NUM_STEPS="50"

# Default guidance scale (leave empty to use config default 7.5)
export DEFAULT_GUIDANCE=""

# Default per-job timeout in seconds (leave empty to use GENERATION_TIMEOUT)
export DEFAULT_TIMEOUT_SECONDS=""

# Worker timeout for entire job processing (seconds)
export GENERATION_TIMEOUT="1800"

# Base directory for temporary video output
export BASE_OUTPUT_DIR="/tmp/opensora_outputs"
